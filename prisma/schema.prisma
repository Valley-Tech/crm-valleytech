// ============================================================================
//  CRM ValleyTech — modelo de datos
//
//  Reglas de diseño:
//   1. Toda tabla de negocio lleva tenantId. Nunca se consulta sin filtrarlo.
//   2. waMessageId es único: es la defensa contra los reintentos de Meta.
//   3. El estado de un mensaje solo avanza (statusRank), nunca retrocede.
//   4. El estado del bot y la etapa del embudo son columnas distintas.
//   5. channel existe desde el día uno para poder sumar Instagram sin migrar todo.
// ============================================================================

generator client {
  provider = "prisma-client-js"
  // Motores que Prisma debe preparar. Sin esto, en el contenedor de Railway
  // (Alpine/musl con OpenSSL 3) la detección falla, asume OpenSSL 1.1 y el
  // cliente revienta con "Error loading shared library libssl.so.1.1".
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Channel {
  whatsapp
  instagram
}

enum UserRole {
  owner
  admin
  agent
  viewer
}

enum ConversationStatus {
  open
  pending
  closed
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageStatus {
  received
  queued
  sent
  delivered
  read
  failed
}

enum MessageSource {
  cloud_api
  agent
  bot
  smb_echo
  history
  campaign
}

enum TemplateStatus {
  pending
  approved
  rejected
  paused
  disabled
}

enum UsageKind {
  inbound_message
  outbound_message
  template_message
}

enum CampaignStatus {
  draft
  scheduled
  running
  paused
  completed
  cancelled
  failed
}

enum CampaignRecipientStatus {
  pending
  queued
  sent
  delivered
  read
  failed
  skipped
}

// ---------------------------------------------------------------------------
// Tenant: cada negocio cliente del SaaS
// ---------------------------------------------------------------------------
model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  plan      String   @default("trial")
  status    String   @default("active") // active | suspended | cancelled
  settings  Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users            User[]
  integrations     MetaIntegration[]
  botIntegrations  BotIntegration[]
  contacts         Contact[]
  conversations    Conversation[]
  messages         Message[]
  templates        Template[]
  notes            ConversationNote[]
  usageEvents      UsageEvent[]
  auditLogs        AuditLog[]
  quickReplies     QuickReply[]
  campaigns        Campaign[]
  campaignRecipients CampaignRecipient[]

  @@map("tenants")
}

// ---------------------------------------------------------------------------
// User: agentes y administradores dentro de un tenant
// ---------------------------------------------------------------------------
model User {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  email        String
  name         String
  passwordHash String    @map("password_hash")
  role         UserRole  @default(agent)
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant                Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedConversations Conversation[]
  sentMessages          Message[]
  notes                 ConversationNote[]
  auditLogs             AuditLog[]
  campaigns             Campaign[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// MetaIntegration: credenciales de WhatsApp Cloud API por número
// Un tenant puede tener varios números. El access token se guarda cifrado.
// ---------------------------------------------------------------------------
model MetaIntegration {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  channel            Channel   @default(whatsapp)
  wabaId             String    @map("waba_id")
  phoneNumberId      String    @unique @map("phone_number_id")
  displayPhoneNumber String    @map("display_phone_number")
  verifiedName       String?   @map("verified_name")
  accessTokenEnc     String    @map("access_token_enc")
  tokenExpiresAt     DateTime? @map("token_expires_at")
  isCoexistence      Boolean   @default(false) @map("is_coexistence")
  syncStatus         String    @default("not_applicable") @map("sync_status")
  qualityRating      String?   @map("quality_rating")
  messagingTier      String?   @map("messaging_tier")
  active             Boolean   @default(true)
  onboardingMethod   String    @default("manual") @map("onboarding_method") // manual | embedded_signup
  // En coexistencia, un eco es un mensaje enviado desde la app (humano o IA de Meta).
  // Si true, un eco pausa el bot del Bot Gateway; con la IA de Meta debe ser false.
  echoPausesBot      Boolean   @default(false) @map("echo_pauses_bot")
  connectedAt        DateTime  @default(now()) @map("connected_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  campaigns     Campaign[]

  @@index([tenantId])
  @@index([wabaId])
  @@map("meta_integrations")
}

// ---------------------------------------------------------------------------
// BotIntegration: un chatbot externo (ValleyTechBot, Samuelito, BlackStation)
// El CRM le despacha eventos firmados y el bot responde por la API del CRM.
// ---------------------------------------------------------------------------
model BotIntegration {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  name           String
  channel        Channel  @default(whatsapp)
  endpointUrl    String   @map("endpoint_url")
  signingSecret  String   @map("signing_secret") // cifrado
  apiKeyHash     String   @unique @map("api_key_hash")
  apiKeyPrefix   String   @map("api_key_prefix")
  active         Boolean  @default(true)
  lastDispatchAt DateTime? @map("last_dispatch_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, channel, active])
  @@map("bot_integrations")
}

// ---------------------------------------------------------------------------
// Contact
// ---------------------------------------------------------------------------
model Contact {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  channel      Channel  @default(whatsapp)
  waId         String   @map("wa_id")
  name         String?
  email        String?
  tags         String[] @default([])
  customFields Json?    @map("custom_fields")
  blocked      Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  messages      Message[]
  campaignRecipients CampaignRecipient[]

  @@unique([tenantId, channel, waId])
  @@index([tenantId])
  @@map("contacts")
}

// ---------------------------------------------------------------------------
// Conversation
// ---------------------------------------------------------------------------
model Conversation {
  id                 String             @id @default(uuid())
  tenantId           String             @map("tenant_id")
  contactId          String             @map("contact_id")
  integrationId      String?            @map("integration_id")
  channel            Channel            @default(whatsapp)
  status             ConversationStatus @default(open)
  pipelineStage      String             @default("nuevo") @map("pipeline_stage")
  assignedUserId     String?            @map("assigned_user_id")
  botActive          Boolean            @default(true) @map("bot_active")
  botPausedUntil     DateTime?          @map("bot_paused_until")
  botState           Json?              @map("bot_state")
  lastInboundAt      DateTime?          @map("last_inbound_at")
  lastMessageAt      DateTime?          @map("last_message_at")
  lastMessagePreview String?            @map("last_message_preview")
  unreadCount        Int                @default(0) @map("unread_count")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact      Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  integration  MetaIntegration?   @relation(fields: [integrationId], references: [id])
  assignedUser User?              @relation(fields: [assignedUserId], references: [id])
  messages     Message[]
  notes        ConversationNote[]
  usageEvents  UsageEvent[]

  @@index([tenantId, status, lastMessageAt])
  @@index([tenantId, assignedUserId])
  @@index([tenantId, contactId])
  @@map("conversations")
}

// ---------------------------------------------------------------------------
// Message
// ---------------------------------------------------------------------------
model Message {
  id             String           @id @default(uuid())
  tenantId       String           @map("tenant_id")
  conversationId String           @map("conversation_id")
  contactId      String?          @map("contact_id")
  channel        Channel          @default(whatsapp)
  direction      MessageDirection
  source         MessageSource    @default(cloud_api)
  type           String           @default("text")
  text           String?
  content        Json
  waMessageId    String?          @unique @map("wa_message_id")
  status         MessageStatus    @default(received)
  statusRank     Int              @default(0) @map("status_rank")
  errorCode      Int?             @map("error_code")
  errorMessage   String?          @map("error_message")

  mediaId         String? @map("media_id")
  mediaMimeType   String? @map("media_mime_type")
  mediaFilename   String? @map("media_filename")
  mediaStorageKey String? @map("media_storage_key")
  mediaSizeBytes  Int?    @map("media_size_bytes")

  sentByUserId String?  @map("sent_by_user_id")
  campaignId   String?  @map("campaign_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id])
  sentByUser   User?        @relation(fields: [sentByUserId], references: [id])
  campaign     Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  usageEvents  UsageEvent[]
  campaignRecipients CampaignRecipient[]

  @@index([conversationId, createdAt])
  @@index([tenantId, createdAt])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// ConversationNote: notas internas, nunca salen a WhatsApp
// ---------------------------------------------------------------------------
model ConversationNote {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  body           String
  createdAt      DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@index([conversationId, createdAt])
  @@map("conversation_notes")
}

// ---------------------------------------------------------------------------
// Template: plantillas HSM sincronizadas desde Meta
// ---------------------------------------------------------------------------
model Template {
  id            String         @id @default(uuid())
  tenantId      String         @map("tenant_id")
  wabaId        String         @map("waba_id")
  metaTemplateId String?       @map("meta_template_id")
  name          String
  language      String         @default("es")
  category      String         @default("UTILITY")
  status        TemplateStatus @default(pending)
  components    Json?
  syncedAt      DateTime       @default(now()) @map("synced_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name, language])
  @@index([tenantId, status])
  @@map("templates")
}

// ---------------------------------------------------------------------------
// UsageEvent: base de la facturación. Meta cobra por mensaje de plantilla.
// ---------------------------------------------------------------------------
model UsageEvent {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  conversationId String?   @map("conversation_id")
  messageId      String?   @map("message_id")
  kind           UsageKind
  category       String? // MARKETING | UTILITY | AUTHENTICATION | SERVICE
  quantity       Int       @default(1)
  occurredAt     DateTime  @default(now()) @map("occurred_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  message      Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt])
  @@index([tenantId, kind, occurredAt])
  @@map("usage_events")
}

// ---------------------------------------------------------------------------
// AuditLog
// ---------------------------------------------------------------------------
model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  actorType   String   @default("user") @map("actor_type") // user | bot | system
  actorUserId String?  @map("actor_user_id")
  action      String
  entity      String
  entityId    String?  @map("entity_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUser User?  @relation(fields: [actorUserId], references: [id])

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// QuickReply: respuestas rápidas del equipo (atajo "/saludo")
// ---------------------------------------------------------------------------
model QuickReply {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  shortcut  String
  title     String
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, shortcut])
  @@map("quick_replies")
}

// ---------------------------------------------------------------------------
// Campaign: envío masivo de una plantilla aprobada a un segmento de contactos
// ---------------------------------------------------------------------------
model Campaign {
  id               String         @id @default(uuid())
  tenantId         String         @map("tenant_id")
  integrationId    String?        @map("integration_id")
  name             String
  templateName     String         @map("template_name")
  templateLanguage String         @default("es") @map("template_language")
  components       Json?
  status           CampaignStatus @default(draft)
  scheduledAt      DateTime?      @map("scheduled_at")
  startedAt        DateTime?      @map("started_at")
  completedAt      DateTime?      @map("completed_at")
  totalRecipients  Int            @default(0) @map("total_recipients")
  sentCount        Int            @default(0) @map("sent_count")
  deliveredCount   Int            @default(0) @map("delivered_count")
  readCount        Int            @default(0) @map("read_count")
  failedCount      Int            @default(0) @map("failed_count")
  createdByUserId  String?        @map("created_by_user_id")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration MetaIntegration?    @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  createdBy   User?               @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  recipients  CampaignRecipient[]
  messages    Message[]

  @@index([tenantId, status])
  @@map("campaigns")
}

model CampaignRecipient {
  id           String                  @id @default(uuid())
  campaignId   String                  @map("campaign_id")
  tenantId     String                  @map("tenant_id")
  contactId    String                  @map("contact_id")
  waId         String                  @map("wa_id")
  params       Json?
  status       CampaignRecipientStatus @default(pending)
  messageId    String?                 @map("message_id")
  errorMessage String?                 @map("error_message")
  sentAt       DateTime?               @map("sent_at")
  createdAt    DateTime                @default(now()) @map("created_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  message  Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
  @@index([messageId])
  @@map("campaign_recipients")
}
