{
  "name": "crm-valleytech",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CRM multi-tenant para chatbots de WhatsApp Business API (ValleyTech)",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "setup": "prisma generate && prisma migrate dev --name init && node prisma/seed.js",
    "dev": "node --watch src/server.js",
    "dev:worker": "node --watch src/worker.js",
    "start": "node src/server.js",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web install --no-audit --no-fund && npm --prefix web run build",
    "postinstall": "prisma generate",
    "start:worker": "node src/worker.js",
    "release": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "keygen": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.7.9",
    "bullmq": "^5.34.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.5.0",
    "pino-http": "^10.4.0",
    "prisma": "^5.22.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "pino-pretty": "^13.0.0"
  }
}
