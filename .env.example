# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Base de datos ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_whatsapp"

# --- Redis (colas BullMQ) ---
REDIS_URL="redis://localhost:6379"

# --- Meta / WhatsApp Cloud API (app-level, NO por tenant) ---
META_APP_ID=""
META_APP_SECRET=""
BASE_URL="https://graph.facebook.com"
API_VERSION="v23.0"

# Config ID que generas en App Dashboard > WhatsApp > Embedded Signup Builder
META_EMBEDDED_SIGNUP_CONFIG_ID=""

# Token usado SOLO para verificar el handshake GET del webhook (tú lo inventas)
WEBHOOK_VERIFY_TOKEN="cambia-esto-por-un-valor-secreto"

# --- Cifrado de credenciales por tenant ---
# Clave de 32 bytes en base64 para AES-256-GCM. Genera una con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIALS_ENCRYPTION_KEY=""
