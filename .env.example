# ============================================================
#  CRM ValleyTech — variables de entorno
#  Copia este archivo a .env y completa los valores.
# ============================================================

NODE_ENV=development
PORT=3000
# URL publica del CRM (la que registras como webhook en Meta).
# En local usa la URL de ngrok/cloudflared, ej: https://abcd1234.ngrok-free.app
PUBLIC_URL=http://localhost:3000

# --- Base de datos -------------------------------------------------
# Con docker compose up -d, esta es la cadena correcta.
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm_valleytech?schema=public"

# --- Redis (colas BullMQ + tiempo real) ----------------------------
REDIS_URL="redis://localhost:6379"

# --- Seguridad -----------------------------------------------------
# Genera cada una con: npm run keygen
JWT_SECRET=""
CREDENTIALS_ENCRYPTION_KEY=""
JWT_EXPIRES_IN=12h

# --- Meta / WhatsApp Cloud API (nivel app, NO por cliente) ---------
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_URL="https://graph.facebook.com"
META_API_VERSION="v23.0"
# Lo inventas tu; debe coincidir con el que pongas en el panel de Meta.
META_WEBHOOK_VERIFY_TOKEN="cambia-esto-por-un-valor-secreto"
# Solo necesario cuando Meta apruebe la revision de la app.
META_EMBEDDED_SIGNUP_CONFIG_ID=""

# --- Almacenamiento de multimedia ----------------------------------
# local | s3   (para s3: npm install @aws-sdk/client-s3)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Comportamiento ------------------------------------------------
# Minutos de pausa del bot cuando un agente toma la conversacion.
BOT_PAUSE_MINUTES=30
# Mensajes por segundo hacia la API de Meta (por proceso worker).
OUTBOUND_RATE_PER_SECOND=20
LOG_LEVEL=info